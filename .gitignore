/vendor/
/report/
/.phpcca.cache/
.phpunit.result.cache
.phpactor.json
/.superpowers/
# working specs and plans stay local; the repo is public
/docs/superpowers/

# transient key the UCP test agent generates per run (scripts/ucp-quote-agent.py).
# The script deletes it in a finally block, but a killed run leaves it on disk -
# which has already happened once. Ignored so it can never be swept into a git add.
scripts/.ucp-agent-key.pem
scripts/__pycache__/
/.playwright-mcp/
/src/Resources/public/
# shopware-cli's "Building plugin Storefront" step writes a compiled bundle here
# when `extension package` runs against the checkout rather than a copy. Build
# output, never source: the plugin's own storefront files live in
# src/Resources/views/storefront/.
/src/Storefront/

# Shopware's administration extension tooling generates this bridge beside the
# plugin's admin sources: absolute paths into the installed administration's
# node_modules and type surface, so it is machine-specific by construction.
# scripts/check-administration.sh regenerates it on every run, and
# sync-to-shop.sh wipes it with the rest of the plugin directory anyway.
/src/Resources/app/administration/.shopware/

# Generated beside it, for the same reason and by the same script. It
# `extends` the .shopware/ bridge above, so it is only meaningful where
# that bridge exists. Committing it broke `shopware-cli extension package`:
# the zip build compiles the admin sources with vite, vite reads any
# tsconfig.json it finds, and the file it extends is not in the zip.
/src/Resources/app/administration/tsconfig.json

# Unreleased AC QA build, shared for local testing only - never commit.
SwagAgenticCommerce-*.zip

# The matrix driver's JSONL readout per bench run (BenchRunTest) -- run
# output, never source.
/var/

# Eval credentials (composer run eval) -- never commit
/.env.eval
