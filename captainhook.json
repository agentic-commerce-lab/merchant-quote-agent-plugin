{
  "config": {
    "fail-on-first-error": true
  },
  "pre-commit": {
    "enabled": true,
    "actions": [
      {
        "action": "vendor/bin/mago fmt --check {$STAGED_FILES|of-type:php|separated-by: }",
        "config": { "label": "Mago format check (staged)" }
      },
      {
        "action": "vendor/bin/mago lint {$STAGED_FILES|of-type:php|separated-by: }",
        "config": { "label": "Mago lint (staged)" }
      }
    ]
  },
  "pre-push": {
    "enabled": true,
    "actions": [
      {
        "action": "vendor/bin/mago analyze",
        "config": { "label": "Mago analyze (whole program)" }
      }
    ]
  }
}
