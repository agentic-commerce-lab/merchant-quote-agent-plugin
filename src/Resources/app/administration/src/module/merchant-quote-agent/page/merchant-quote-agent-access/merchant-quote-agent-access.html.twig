{% block merchant_quote_agent_access %}
<sw-page class="merchant-quote-agent-access">
    {% block merchant_quote_agent_access_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('merchant-quote-agent.access.cardTitle') }}</h2>
    </template>
    {% endblock %}

    {% block merchant_quote_agent_access_content %}
    <template #content>
        <sw-card-view>
            {% block merchant_quote_agent_access_card %}
            <mt-card
                :title="$tc('merchant-quote-agent.access.cardTitle')"
                :is-loading="isLoading"
            >
                {# The 140-word wall this replaces explained all three fields'
                   fallback rules before the reader had seen a field, and got
                   the deny-all case wrong. The per-field help below carries the
                   rules; the privilege note only matters when it bites. #}
                <mt-banner v-if="!canEdit" variant="attention">
                    {{ $tc('merchant-quote-agent.access.forbidden') }}
                </mt-banner>

                <mt-banner v-if="error" variant="critical">
                    {{ error }}
                </mt-banner>

                <mt-select
                    :label="$tc('merchant-quote-agent.access.salesChannelLabel')"
                    :options="salesChannels.map((channel) => ({ value: channel.id, label: channel.name }))"
                    :model-value="salesChannelId"
                    :disabled="isLoading"
                    @update:model-value="(value) => { salesChannelId = value; configLoaded = false; loadConfig(); }"
                />

                <mt-checkbox
                    :label="$tc('merchant-quote-agent.access.identityLinkingLabel')"
                    :help-text="$tc('merchant-quote-agent.access.identityLinkingHelp')"
                    :disabled="!canEdit || isLoading"
                    :model-value="identityLinkingEnabled"
                    @update:model-value="(value) => { identityLinkingEnabled = value; }"
                />

                <div class="mqa-access__lists">
                    <mt-textarea
                        :label="$tc('merchant-quote-agent.access.platformAllowlistLabel')"
                        :help-text="$tc('merchant-quote-agent.access.platformAllowlistHelp')"
                        :placeholder="$tc('merchant-quote-agent.access.hostPlaceholder')"
                        :disabled="!canEdit || isLoading"
                        :model-value="lists.platformAllowlist"
                        @update:model-value="(value) => { lists.platformAllowlist = value; }"
                    />

                    <mt-textarea
                        :label="$tc('merchant-quote-agent.access.remoteProfileAllowlistLabel')"
                        :help-text="$tc('merchant-quote-agent.access.remoteProfileAllowlistHelp')"
                        :placeholder="$tc('merchant-quote-agent.access.hostPlaceholder')"
                        :disabled="!canEdit || isLoading"
                        :model-value="lists.remoteProfileAllowlist"
                        @update:model-value="(value) => { lists.remoteProfileAllowlist = value; }"
                    />

                    <mt-textarea
                        :label="$tc('merchant-quote-agent.access.agentAllowlistLabel')"
                        :help-text="$tc('merchant-quote-agent.access.agentAllowlistHelp')"
                        :placeholder="$tc('merchant-quote-agent.access.hostPlaceholder')"
                        :disabled="!canEdit || isLoading"
                        :model-value="lists.agentAllowlist"
                        @update:model-value="(value) => { lists.agentAllowlist = value; }"
                    />
                </div>

                {# configLoaded is load-bearing, not cosmetic: the PUT replaces
                   enabledCapabilities wholesale, so saving before a config has
                   ever loaded for this channel — or after a load failed, e.g.
                   a missing ucp.viewer or a network blip — would PUT whatever
                   is left in `capabilities` (empty, or a stale other
                   channel's) and silently disable every capability on this
                   sales channel. #}
                <mt-button
                    variant="primary"
                    :disabled="!canEdit || isLoading || isSaving || !salesChannelId || !configLoaded"
                    @click="save"
                >
                    {{ $tc('merchant-quote-agent.access.save') }}
                </mt-button>
            </mt-card>
            {% endblock %}

            {# Three empty boxes cannot tell a merchant whether the shop is open
               or shut. This says what the fields above actually come to. #}
            {% block merchant_quote_agent_access_effective %}
            <mt-card
                v-if="salesChannelId"
                :title="$tc('merchant-quote-agent.access.effectiveTitle')"
                :is-loading="isLoading"
            >
                <dl class="mqa-run__facts">
                    <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.access.remoteProfileAllowlistLabel') }}</dt>
                    <dd class="mqa-run__fact-value">
                        <span v-if="effective.profile.hosts.length" class="mqa-access__hosts">
                            {{ effective.profile.hosts.join(', ') }}
                        </span>
                        <span v-else class="mqa-access__none">{{ $tc('merchant-quote-agent.access.resolvesToNothing') }}</span>
                        <span class="mqa-run__quiet">{{ $tc(`merchant-quote-agent.access.source.${effective.profile.source}`) }}</span>
                    </dd>

                    <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.access.agentAllowlistLabel') }}</dt>
                    <dd class="mqa-run__fact-value">
                        <span v-if="effective.agent.hosts.length" class="mqa-access__hosts">
                            {{ effective.agent.hosts.join(', ') }}
                        </span>
                        <span v-else class="mqa-access__none">{{ $tc('merchant-quote-agent.access.resolvesToNothing') }}</span>
                        <span class="mqa-run__quiet">{{ $tc(`merchant-quote-agent.access.source.${effective.agent.source}`) }}</span>
                    </dd>

                    <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.access.fallbackHost') }}</dt>
                    <dd class="mqa-run__fact-value">
                        <span v-if="channelHost" class="mqa-access__hosts">{{ channelHost }}</span>
                        <span v-else class="mqa-access__none">{{ $tc('merchant-quote-agent.access.noDomain') }}</span>
                    </dd>
                </dl>

                <p class="mqa-figures__note">{{ $tc('merchant-quote-agent.access.effectiveNote') }}</p>
            </mt-card>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
