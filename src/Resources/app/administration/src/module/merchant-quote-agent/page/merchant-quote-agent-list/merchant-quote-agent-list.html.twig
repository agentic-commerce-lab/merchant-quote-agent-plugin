{% block merchant_quote_agent_list %}
<sw-page class="merchant-quote-agent-list">
    {% block merchant_quote_agent_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('merchant-quote-agent.general.mainMenuItemGeneral') }}</h2>
    </template>
    {% endblock %}

    {# The period scopes the whole page — both the figures and the rows — so it
       belongs in the smart bar. The width lives on a wrapper: set on the select
       itself it loses to the component's own rule, and the smart bar's
       right-alignment pushes the text under the chevron. #}
    {% block merchant_quote_agent_list_smart_bar_actions %}
    <template #smart-bar-actions>
        <div class="mqa-page__range">
            <sw-single-select
                v-model:value="rangeDays"
                :options="rangeOptions"
                :show-clearable-button="false"
            />
        </div>
    </template>
    {% endblock %}

    {% block merchant_quote_agent_list_content %}
    <template #content>
        <sw-card-view>
            {% block merchant_quote_agent_list_figures %}
            <sw-card :title="$tc('merchant-quote-agent.figures.title')" :is-loading="isLoading">
                {# Four measures, each with the comparison that makes it mean
                   something: a rate needs a trend, a duration needs an SLA, and a
                   discount or a cycle time needs the deals the agent never touched.
                   A figure with no comparison available says so rather than standing
                   alone as if it were self-evident. #}
                <div class="mqa-figures">
                    {% block merchant_quote_agent_list_auto_execution %}
                    <div class="mqa-figure mqa-figure--meter">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.autoExecution') }}</span>
                        <span class="mqa-figure__value">{{ formatPercent(autoExecution.rate) }}</span>
                        <span class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.figures.autoExecutionAside', {
                                escalated: autoExecution.escalated,
                                total: autoExecution.total,
                            }) }}
                        </span>
                        {# The share is also drawn, because a rate reads faster as a
                           bar. The count above it is always present, so nothing is
                           encoded by colour alone. #}
                        <div v-if="autoExecution.rate !== null" class="mqa-meter">
                            <div class="mqa-meter__fill" :style="{ width: autoExecution.rate + '%' }"></div>
                        </div>
                        <span v-if="autoExecutionDelta !== null" class="mqa-figure__aside mqa-trend">
                            <template v-if="Math.abs(autoExecutionDelta) < 0.05">
                                {{ $t('merchant-quote-agent.figures.trendFlat', { days: rangeDays }) }}
                            </template>
                            <template v-else-if="autoExecutionDelta > 0">
                                {{ $t('merchant-quote-agent.figures.trendUp', {
                                    delta: formatPercent(autoExecutionDelta),
                                    days: rangeDays,
                                }) }}
                            </template>
                            <template v-else>
                                {{ $t('merchant-quote-agent.figures.trendDown', {
                                    delta: formatPercent(-autoExecutionDelta),
                                    days: rangeDays,
                                }) }}
                            </template>
                        </span>
                    </div>
                    {% endblock %}

                    {% block merchant_quote_agent_list_resolution %}
                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.resolution') }}</span>
                        <span class="mqa-figure__value">{{ formatSpan(escalations.meanMs) }}</span>
                        <span v-if="escalations.withinSla !== null" class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.figures.withinSla', {
                                within: escalations.withinSla,
                                measured: escalations.measured,
                                sla: formatSpan(slaHours * 3600000),
                            }) }}
                        </span>
                        <span v-else class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.figures.noSla', { measured: escalations.measured }) }}
                        </span>
                        {# Reported beside the average, not folded into it. At release
                           every escalation raised before the resolved_at migration is
                           open, and a backlog has to read as a backlog rather than
                           quietly vanishing from the average. #}
                        <span v-if="escalations.open > 0" class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.figures.openEscalations', { open: escalations.open }) }}
                        </span>
                    </div>
                    {% endblock %}

                    {% block merchant_quote_agent_list_retention %}
                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.retention') }}</span>
                        <span class="mqa-figure__value">
                            <template v-if="dealsUnavailable">{{ $tc('merchant-quote-agent.figures.unavailable') }}</template>
                            <template v-else>{{ formatPercent(retention.agentDiscount) }}</template>
                        </span>
                        <span v-if="dealsUnavailable" class="mqa-figure__aside">
                            {{ $tc('merchant-quote-agent.figures.unavailableQuotes') }}
                        </span>
                        <span v-else-if="retention.baselineDiscount !== null" class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.figures.retentionBaseline', {
                                baseline: formatPercent(retention.baselineDiscount),
                            }) }}
                        </span>
                        <span v-else class="mqa-figure__aside">
                            {{ $tc('merchant-quote-agent.figures.noBaseline') }}
                        </span>
                        <span v-if="!dealsUnavailable && retention.baselineDiscount !== null" class="mqa-figure__aside">
                            {{ $tc('merchant-quote-agent.figures.retentionFootnote') }}
                        </span>
                    </div>
                    {% endblock %}

                    {% block merchant_quote_agent_list_cycle_time %}
                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.cycleTime') }}</span>
                        <span class="mqa-figure__value">
                            <template v-if="dealsUnavailable">{{ $tc('merchant-quote-agent.figures.unavailable') }}</template>
                            <template v-else>{{ formatSpan(cycleTime.agentMs) }}</template>
                        </span>
                        <span v-if="dealsUnavailable" class="mqa-figure__aside">
                            {{ $tc('merchant-quote-agent.figures.unavailableQuotes') }}
                        </span>
                        {# Order dates specifically missing, not "no deals": without
                           `order:read` every confirmedAt comes back empty and the
                           tile would otherwise read as a quiet zero-comparable
                           period rather than the permission gap it actually is. #}
                        <span v-else-if="orderDatesUnavailable" class="mqa-figure__aside">
                            {{ $tc('merchant-quote-agent.figures.unavailableOrders') }}
                        </span>
                        <span v-else-if="cycleTime.baselineMs !== null" class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.figures.cycleBaseline', {
                                baseline: formatSpan(cycleTime.baselineMs),
                            }) }}
                        </span>
                        <span v-else class="mqa-figure__aside">
                            {{ $tc('merchant-quote-agent.figures.noBaseline') }}
                        </span>
                    </div>
                    {% endblock %}
                </div>
            </sw-card>
            {% endblock %}

            {# One row per negotiation strategy, the same measures as the tiles
               above. No highlighting and no score sort: B2B quote volume does
               not reach significance at the per-strategy split, and #99 is
               explicit that dressing 6 vs 4 up as a result is the failure
               mode this table must not repeat. #}
            {% block merchant_quote_agent_list_strategy_comparison %}
            <sw-card :title="$tc('merchant-quote-agent.strategyComparison.title')" :is-loading="isLoading">
                <sw-data-grid
                    v-if="strategyComparison.length"
                    :data-source="strategyComparison"
                    :columns="strategyColumns"
                    :is-loading="isLoading"
                    :plain-appearance="true"
                    :show-selection="false"
                    :show-settings="false"
                    :show-actions="false"
                    :allow-column-edit="false"
                >
                    <template #column-name="{ item }">
                        <div class="mqa-cell">
                            <div class="mqa-cell__title">
                                <mt-badge v-if="item.name === null" variant="neutral">
                                    {{ $tc('merchant-quote-agent.strategyComparison.unattributed') }}
                                </mt-badge>
                                <strong v-else>{{ item.name }}</strong>
                                {# The version spread, not the version itself: this table rolled the
                                   strategy's versions up into one row precisely so a prompt edit does
                                   not fragment it into a second, identically-labelled row. Empty for an
                                   unattributed row -- there is no version to report. #}
                                <span v-if="item.versions.length === 1" class="mqa-cell__aside">
                                    {{ $t('merchant-quote-agent.strategyComparison.versionSingle', { version: item.versions[0] }) }}
                                </span>
                                <span v-else-if="item.versions.length > 1" class="mqa-cell__aside">
                                    {{ $t('merchant-quote-agent.strategyComparison.versionRange', {
                                        from: item.versions[0],
                                        to: item.versions[item.versions.length - 1],
                                    }) }}
                                </span>
                            </div>
                            <span v-if="item.mixedQuotes > 0" class="mqa-cell__aside">
                                {{ $t('merchant-quote-agent.strategyComparison.mixedFootnote', { count: item.mixedQuotes }) }}
                            </span>
                        </div>
                    </template>

                    <template #column-quotes="{ item }">
                        {{ item.quotes }}
                    </template>

                    <template #column-autoExecution="{ item }">
                        <div class="mqa-cell">
                            <span class="mqa-cell__value">{{ formatPercent(item.autoExecution.rate) }}</span>
                            <span class="mqa-cell__aside">
                                {{ $t('merchant-quote-agent.figures.autoExecutionAside', {
                                    escalated: item.autoExecution.escalated,
                                    total: item.autoExecution.total,
                                }) }}
                            </span>
                        </div>
                    </template>

                    <template #column-escalations="{ item }">
                        <div class="mqa-cell">
                            <span class="mqa-cell__value">{{ formatSpan(item.escalations.meanMs) }}</span>
                            <span class="mqa-cell__aside">
                                {{ $t('merchant-quote-agent.strategyComparison.escalationsAside', { measured: item.escalations.measured }) }}
                            </span>
                            <span v-if="item.escalations.open > 0" class="mqa-cell__aside">
                                {{ $t('merchant-quote-agent.figures.openEscalations', { open: item.escalations.open }) }}
                            </span>
                        </div>
                    </template>

                    <template #column-priceRetention="{ item }">
                        {{ $t('merchant-quote-agent.strategyComparison.retentionValue', {
                            agent: formatPercent(item.priceRetention.agentDiscount),
                            baseline: formatPercent(item.priceRetention.baselineDiscount),
                        }) }}
                    </template>

                    <template #column-cycleTime="{ item }">
                        {{ $t('merchant-quote-agent.strategyComparison.retentionValue', {
                            agent: formatSpan(item.cycleTime.agentMs),
                            baseline: formatSpan(item.cycleTime.baselineMs),
                        }) }}
                    </template>

                    <template #column-tokens="{ item }">
                        <div class="mqa-cell">
                            <span class="mqa-cell__value">{{ item.tokens.meanTokens === null ? '–' : Math.round(item.tokens.meanTokens) }}</span>
                            <span class="mqa-cell__aside">
                                {{ $t('merchant-quote-agent.strategyComparison.tokensAside', {
                                    quotes: item.tokens.quotes,
                                    total: item.quotes,
                                }) }}
                            </span>
                        </div>
                    </template>
                </sw-data-grid>

                <sw-empty-state
                    v-else-if="!isLoading"
                    :absolute="false"
                    :title="$tc('merchant-quote-agent.strategyComparison.emptyStateTitle')"
                />

                <p class="mqa-figures__note">{{ $tc('merchant-quote-agent.strategyComparison.disclaimer') }}</p>
            </sw-card>
            {% endblock %}

            {% block merchant_quote_agent_list_grid %}
            <sw-card :title="$tc('merchant-quote-agent.list.gridTitle')">
                <div class="mqa-list__toolbar">
                    <sw-single-select
                        v-model:value="dispositionFilter"
                        :options="dispositionFilterOptions"
                        :label="$tc('merchant-quote-agent.list.filterLabel')"
                        :show-clearable-button="false"
                    />
                </div>

                <mt-banner v-if="isTruncated" variant="attention">
                    {{ $t('merchant-quote-agent.list.truncated', { shown: quotes.length, total: passTotal }) }}
                </mt-banner>

                {# One row per quote, not per pass. A three-round negotiation
                   used to appear as three unrelated rows repeating the same
                   quote number. #}
                <sw-data-grid
                    v-if="pagedQuotes.length"
                    :data-source="pagedQuotes"
                    :columns="columns"
                    :is-loading="isLoading"
                    :plain-appearance="true"
                    :show-selection="false"
                    :show-settings="false"
                    :show-actions="acl.can('merchant_quote_agent.deleter')"
                    :allow-column-edit="false"
                >
                    <template #column-quoteNumber="{ item }">
                        <div class="mqa-cell">
                            <router-link :to="{ name: 'merchant.quote.agent.detail', params: { id: item.latest.id } }">
                                <strong>#{{ item.quoteNumber || '–' }}</strong>
                            </router-link>
                            <span v-if="item.rounds > 1" class="mqa-cell__aside">
                                {{ $t('merchant-quote-agent.list.roundCount', { count: item.rounds }) }}
                            </span>
                        </div>
                    </template>

                    {# The reason explains the standing, so it sits with it. #}
                    <template #column-disposition="{ item }">
                        <div class="mqa-cell">
                            {# Both off the disposition. Reading the label from
                               one value and the colour from another is how an
                               ordered quote whose last pass escalated came out
                               as "Order placed" in red. #}
                            <mt-badge :variant="dispositionVariant(item.disposition)">
                                {{ dispositionLabel(item.disposition) }}
                            </mt-badge>
                            <span v-if="item.latest.escalationReason" class="mqa-cell__aside">
                                {{ escalationLabel(item.latest.escalationReason) }}
                            </span>
                        </div>
                    </template>

                    <template #column-asked="{ item }">
                        <span class="mqa-ask" :title="askSummary(item.latest.interpretedAsks)">
                            {{ askSummary(item.latest.interpretedAsks) }}
                        </span>
                    </template>

                    <template #column-granted="{ item }">
                        <div class="mqa-cell">
                            <span class="mqa-cell__value">{{ grantedLabel(item) }}</span>
                            <span
                                v-if="answeredTheBuyer(item.latest.outcome) && item.latest.totalNetAfter !== null"
                                class="mqa-cell__aside"
                            >
                                {{ formatCurrency(item.latest.totalNetAfter, item.latest.currencyIso) }}
                            </span>
                        </div>
                    </template>

                    <template #column-lastActivity="{ item }">
                        {{ formatDateShort(item.latest.createdAt) }}
                    </template>

                    <template #actions="{ item }">
                        <sw-context-menu-item variant="danger" @click="pendingDelete = item">
                            {{ $tc('merchant-quote-agent.list.deleteRows') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>

                <sw-empty-state
                    v-else-if="!isLoading"
                    :absolute="false"
                    :title="$tc('merchant-quote-agent.list.emptyStateTitle')"
                    :subline="$tc('merchant-quote-agent.list.emptyStateSubline')"
                />

                <sw-pagination
                    v-if="pageCount > 1"
                    :page="page"
                    :limit="pageSize"
                    :total="filteredQuotes.length"
                    :steps="[]"
                    @page-change="onPageChange"
                />
            </sw-card>
            {% endblock %}

            {# An audit row cannot be rebuilt, so deleting one asks first. #}
            {% block merchant_quote_agent_list_delete_modal %}
            <sw-modal
                v-if="pendingDelete"
                variant="small"
                :title="$tc('merchant-quote-agent.list.deleteTitle')"
                @modal-close="pendingDelete = null"
            >
                <p>
                    {{ $t('merchant-quote-agent.list.deleteBody', {
                        quoteNumber: pendingDelete.quoteNumber || '–',
                        count: pendingDelete.rounds,
                    }) }}
                </p>

                <template #modal-footer>
                    <mt-button size="small" variant="secondary" @click="pendingDelete = null">
                        {{ $tc('global.default.cancel') }}
                    </mt-button>
                    <mt-button size="small" variant="critical" @click="confirmDelete">
                        {{ $tc('merchant-quote-agent.list.deleteConfirm') }}
                    </mt-button>
                </template>
            </sw-modal>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
