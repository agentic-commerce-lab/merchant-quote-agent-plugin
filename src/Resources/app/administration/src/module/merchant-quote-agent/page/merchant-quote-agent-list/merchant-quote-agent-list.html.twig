{% block merchant_quote_agent_list %}
<sw-page class="merchant-quote-agent-list">
    {% block merchant_quote_agent_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('merchant-quote-agent.general.mainMenuItemGeneral') }}</h2>
    </template>
    {% endblock %}

    {# The period scopes the whole page — both the figures and the grid — so it
       belongs in the smart bar rather than in a card of its own labelled the
       same as its one field. The width lives on a wrapper: set on the select
       itself it loses to the component's own rule and the chevron lands on the
       text. #}
    {% block merchant_quote_agent_list_smart_bar_actions %}
    <template #smart-bar-actions>
        <div class="mqa-page__range">
            <sw-single-select
                v-model:value="rangeDays"
                :options="rangeOptions"
                :show-clearable-button="false"
            />
        </div>
    </template>
    {% endblock %}

    {% block merchant_quote_agent_list_content %}
    <template #content>
        <sw-card-view>
            {% block merchant_quote_agent_list_figures %}
            <sw-card
                v-if="figures"
                :title="$tc('merchant-quote-agent.figures.title')"
                class="merchant-quote-agent-figures"
            >
                <div class="mqa-figures">
                    <div v-if="figures.received !== null" class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.received') }}</span>
                        <span class="mqa-figure__value">{{ figures.received }}</span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.handled') }}</span>
                        <span class="mqa-figure__value">{{ figures.handled }}</span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.autoAnswered') }}</span>
                        <span class="mqa-figure__value">{{ figures.answered }}</span>
                        <span v-if="share(figures.answered) !== null" class="mqa-figure__aside">
                            {{ share(figures.answered) }}%
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.escalated') }}</span>
                        <span class="mqa-figure__value">{{ figures.escalated }}</span>
                        <span v-if="share(figures.escalated) !== null" class="mqa-figure__aside">
                            {{ share(figures.escalated) }}%
                        </span>
                    </div>

                    <div v-if="figures.expiredUnanswered !== null" class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.expiredUnanswered') }}</span>
                        <span class="mqa-figure__value">{{ figures.expiredUnanswered }}</span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.valueHandled') }}</span>
                        <span class="mqa-figure__value">
                            <template v-if="figures.valueCurrency">
                                {{ formatCurrency(figures.valueHandled, figures.valueCurrency) }}
                            </template>
                            <template v-else>{{ figures.valueHandled.toFixed(2) }}</template>
                        </span>
                        <span v-if="!figures.valueCurrency" class="mqa-figure__aside">
                            {{ $tc('merchant-quote-agent.figures.mixedCurrencies') }}
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.figures.granted') }}</span>
                        <span class="mqa-figure__value">{{ formatPercent(figures.granted) }}</span>
                        <span v-if="figures.cap !== null" class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.figures.againstCap', { cap: formatPercent(figures.cap) }) }}
                        </span>
                    </div>
                </div>

                {# Answered and escalated can both apply to one quote across its
                   rounds, so they are shares, not a split. Saying so beats
                   letting the merchant read them as a broken sum. #}
                <p class="mqa-figures__note">
                    {{ $t('merchant-quote-agent.figures.shareNote', { handled: figures.handled }) }}
                </p>
            </sw-card>
            {% endblock %}

            {% block merchant_quote_agent_list_grid %}
            <sw-card :title="$tc('merchant-quote-agent.list.gridTitle')">
                <div class="mqa-list__toolbar">
                    <sw-single-select
                        v-model:value="outcomeFilter"
                        :options="outcomeFilterOptions"
                        :label="$tc('merchant-quote-agent.list.filterLabel')"
                        :show-clearable-button="false"
                    />
                </div>

                <sw-entity-listing
                    v-if="decisions && decisions.length"
                    :repository="decisionRepository"
                    :data-source="decisions"
                    :columns="columns"
                    :is-loading="isLoading"
                    :sort-by="sortBy"
                    :sort-direction="sortDirection"
                    :full-page="false"
                    :plain-appearance="true"
                    :show-selection="false"
                    :show-settings="false"
                    :allow-edit="false"
                    :allow-inline-edit="false"
                    :allow-view="true"
                    :allow-delete="acl.can('merchant_quote_agent.deleter')"
                    detail-route="merchant.quote.agent.detail"
                >
                    {# One row is one servicing pass, so a three-round
                       negotiation is three rows. The round count says so
                       instead of leaving the repetition to be puzzled out. #}
                    <template #column-quoteNumber="{ item }">
                        <div class="mqa-cell">
                            <router-link :to="{ name: 'merchant.quote.agent.detail', params: { id: item.id } }">
                                <strong>#{{ item.quoteNumber || '–' }}</strong>
                            </router-link>
                            <span v-if="rounds(item) > 1" class="mqa-cell__aside">
                                {{ $t('merchant-quote-agent.list.roundCount', { count: rounds(item) }) }}
                            </span>
                        </div>
                    </template>

                    {# The reason explains the outcome, so it sits with it. It
                       used to sit in the offer column, which then had no room
                       left to say what was offered. #}
                    <template #column-outcome="{ item }">
                        <div class="mqa-cell">
                            <mt-badge :variant="outcomeVariant(item.outcome)">
                                {{ outcomeLabel(item.outcome) }}
                            </mt-badge>
                            <span v-if="item.escalationReason" class="mqa-cell__aside">
                                {{ escalationLabel(item.escalationReason) }}
                            </span>
                        </div>
                    </template>

                    <template #column-interpretedAsks="{ item }">
                        <span :title="askSummary(item.interpretedAsks)">
                            {{ askSummary(item.interpretedAsks) }}
                        </span>
                    </template>

                    <template #column-discountPercentGranted="{ item }">
                        <div class="mqa-cell">
                            <span class="mqa-cell__value">{{ grantedLabel(item) }}</span>
                            <span v-if="answeredTheBuyer(item.outcome) && item.totalNetAfter !== null" class="mqa-cell__aside">
                                {{ formatCurrency(item.totalNetAfter, item.currencyIso) }}
                            </span>
                        </div>
                    </template>

                    <template #column-createdAt="{ item }">
                        {{ formatDate(item.createdAt) }}
                    </template>
                </sw-entity-listing>

                <sw-empty-state
                    v-else-if="!isLoading"
                    :absolute="false"
                    :title="$tc('merchant-quote-agent.list.emptyStateTitle')"
                    :subline="$tc('merchant-quote-agent.list.emptyStateSubline')"
                />
            </sw-card>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
