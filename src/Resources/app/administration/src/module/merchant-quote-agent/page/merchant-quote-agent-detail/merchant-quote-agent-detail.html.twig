{% block merchant_quote_agent_detail %}
<sw-page class="merchant-quote-agent-detail">
    {% block merchant_quote_agent_detail_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $t('merchant-quote-agent.detail.pageTitle', { quoteNumber: quoteNumber }) }}</h2>
    </template>
    {% endblock %}

    {% block merchant_quote_agent_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {# A button that navigates, not an anchor wrapping a button: nesting the
           two gives a keyboard user two tab stops for one action. mt-button
           takes no router-link prop, so the push is explicit. #}
        <mt-button
            v-if="quoteRoute"
            variant="primary"
            size="small"
            @click="$router.push(quoteRoute)"
        >
            {{ $tc('merchant-quote-agent.detail.openQuote') }}
        </mt-button>
    </template>
    {% endblock %}

    {% block merchant_quote_agent_detail_content %}
    <template #content>
        <sw-card-view>
            {% block merchant_quote_agent_detail_overview %}
            <sw-card :title="$tc('merchant-quote-agent.detail.summaryTitle')" :is-loading="isLoading">
                <div v-if="record" class="mqa-figures">
                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.status') }}</span>
                        <span class="mqa-figure__value">
                            <mt-badge :variant="statusVariant">{{ statusLabel }}</mt-badge>
                        </span>
                        {# A quote with no terminal state has not ended, whatever
                           its last pass did. Calling that a final status was
                           simply wrong. #}
                        <span class="mqa-figure__aside">
                            <template v-if="isInFlight">{{ $tc('merchant-quote-agent.detail.stillOpen') }}</template>
                            <template v-else>{{ formatDate(terminalAt) }}</template>
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.passes') }}</span>
                        <span class="mqa-figure__value">{{ totalRounds }}</span>
                        <span class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.detail.passesAnswered', { count: answeredRounds }) }}
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.offeredNet') }}</span>
                        <span class="mqa-figure__value">
                            {{ latestOffer ? formatCurrency(latestOffer.raw.totalNetAfter, latestOffer.raw.currencyIso) : '–' }}
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.offeredDiscount') }}</span>
                        <span class="mqa-figure__value">{{ latestOffer ? latestOffer.granted : '–' }}</span>
                        <span v-if="latestOffer" class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.figures.ofCap', { cap: latestOffer.cap }) }}
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.lastActivity') }}</span>
                        <span class="mqa-figure__value mqa-figure__value--text">{{ formatDate(lastActivity) }}</span>
                    </div>
                </div>

                <sw-empty-state
                    v-else-if="!isLoading"
                    :absolute="false"
                    :title="$tc('merchant-quote-agent.detail.missingTitle')"
                    :subline="$tc('merchant-quote-agent.detail.missingSubline')"
                />
            </sw-card>
            {% endblock %}

            {# One card holding one sequence. Every run used to be its own card,
               which gave a pass that did nothing the same weight as the round
               that made the offer. #}
            {% block merchant_quote_agent_detail_timeline %}
            <sw-card v-if="record" :title="$tc('merchant-quote-agent.detail.flowTitle')">
                <ol class="mqa-timeline">
                    <li
                        v-for="run in runs"
                        :key="run.id"
                        class="mqa-run"
                        :class="`mqa-run--${run.outcomeVariant}`"
                    >
                        <div class="mqa-run__header">
                            <span class="mqa-run__index">{{ run.index }}</span>
                            <h4 class="mqa-run__title">{{ run.title }}</h4>
                            <mt-badge :variant="run.outcomeVariant">{{ run.outcomeLabel }}</mt-badge>
                            <span class="mqa-run__time">{{ run.timestamp }}</span>
                        </div>

                        <dl v-if="!run.isNoop" class="mqa-run__facts">
                            {# What the buyer asked for. Only ever recorded in
                               structured form, so this is all of it. #}
                            <template v-if="run.asks.length">
                                <template v-for="ask in run.asks" :key="ask.label">
                                    <dt class="mqa-run__fact-label">{{ ask.label }}</dt>
                                    <dd class="mqa-run__fact-value mqa-run__fact-value--numeric">{{ ask.value }}</dd>
                                </template>
                            </template>

                            <template v-if="run.band">
                                <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.detail.bandLabel') }}</dt>
                                <dd class="mqa-run__fact-value">
                                    <mt-badge :variant="run.bandVariant">{{ run.band }}</mt-badge>
                                    <span class="mqa-run__quiet">
                                        {{ $t('merchant-quote-agent.figures.ofCap', { cap: run.cap }) }}
                                    </span>
                                </dd>
                            </template>

                            <template v-if="run.granted">
                                <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.detail.granted') }}</dt>
                                <dd class="mqa-run__fact-value mqa-run__fact-value--numeric">
                                    <span class="mqa-run__granted">{{ run.granted }}</span>
                                    <span v-if="run.totals" class="mqa-run__quiet">{{ run.totals }}</span>
                                </dd>
                            </template>

                            <template v-if="run.escalationReason">
                                <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.detail.escalationReason') }}</dt>
                                <dd class="mqa-run__fact-value">{{ run.escalationReason }}</dd>
                            </template>

                            <template v-if="run.reply">
                                <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.detail.replyLabel') }}</dt>
                                <dd class="mqa-run__fact-value mqa-run__message">{{ run.reply }}</dd>
                            </template>
                        </dl>

                        <details class="mqa-tech">
                            <summary>{{ $tc('merchant-quote-agent.detail.technicalDetails') }}</summary>
                            <div class="mqa-tech__grid">
                                <div v-for="row in run.technical" :key="row.label">
                                    <span class="mqa-tech__label">{{ row.label }}</span>
                                    <span
                                        class="mqa-tech__value"
                                        :class="{ 'mqa-tech__value--mono': row.mono }"
                                    >{{ row.value }}</span>
                                </div>
                            </div>
                        </details>
                    </li>
                </ol>
            </sw-card>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
