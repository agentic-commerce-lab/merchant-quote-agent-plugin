{% block merchant_quote_agent_detail %}
<sw-page class="merchant-quote-agent-detail">
    {% block merchant_quote_agent_detail_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $t('merchant-quote-agent.detail.pageTitle', { quoteNumber: quoteNumber }) }}</h2>
    </template>
    {% endblock %}

    {% block merchant_quote_agent_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {# A button that navigates, not an anchor wrapping a button: nesting the
           two gives a keyboard user two tab stops for one action. mt-button
           takes no router-link prop, so the push is explicit. #}
        <mt-button
            v-if="orderPlaced && orderRoute"
            variant="primary"
            size="small"
            @click="$router.push(orderRoute)"
        >
            {{ $tc('merchant-quote-agent.detail.openOrder') }}
        </mt-button>

        <mt-button
            v-if="quoteRoute"
            :variant="orderPlaced && orderRoute ? 'secondary' : 'primary'"
            size="small"
            @click="$router.push(quoteRoute)"
        >
            {{ $tc('merchant-quote-agent.detail.openQuote') }}
        </mt-button>
    </template>
    {% endblock %}

    {% block merchant_quote_agent_detail_content %}
    <template #content>
        <sw-card-view>
            {% block merchant_quote_agent_detail_overview %}
            <sw-card :title="$tc('merchant-quote-agent.detail.summaryTitle')" :is-loading="isLoading">
                <div v-if="record" class="mqa-figures">
                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.status') }}</span>
                        <span class="mqa-figure__value">
                            <mt-badge :variant="statusVariant">{{ statusLabel }}</mt-badge>
                        </span>
                        {# A quote with no terminal state has not ended, whatever
                           its last pass did. Calling that a final status was
                           simply wrong. #}
                        <span class="mqa-figure__aside">
                            <template v-if="isInFlight">{{ $tc('merchant-quote-agent.detail.stillOpen') }}</template>
                            <template v-else-if="orderPlaced">
                                {{ $t('merchant-quote-agent.detail.orderPlacedAt', { at: formatDate(terminalAt) }) }}
                            </template>
                            <template v-else>{{ formatDate(terminalAt) }}</template>
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.passes') }}</span>
                        <span class="mqa-figure__value">{{ totalRounds }}</span>
                        <span class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.detail.passesAnswered', { count: answeredRounds }) }}
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.offeredNet') }}</span>
                        <span class="mqa-figure__value">
                            {{ latestOffer ? formatCurrency(latestOffer.raw.totalNetAfter, latestOffer.raw.currencyIso) : '–' }}
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.offeredDiscount') }}</span>
                        <span class="mqa-figure__value">{{ latestOffer ? latestOffer.granted : '–' }}</span>
                        <span v-if="latestOffer" class="mqa-figure__aside">
                            {{ $t('merchant-quote-agent.figures.ofCap', { cap: latestOffer.cap }) }}
                        </span>
                    </div>

                    <div class="mqa-figure">
                        <span class="mqa-figure__label">{{ $tc('merchant-quote-agent.detail.lastActivity') }}</span>
                        <span class="mqa-figure__value mqa-figure__value--text">{{ formatDate(lastActivity) }}</span>
                    </div>
                </div>

                <sw-empty-state
                    v-else-if="!isLoading"
                    :absolute="false"
                    :title="$tc('merchant-quote-agent.detail.missingTitle')"
                    :subline="$tc('merchant-quote-agent.detail.missingSubline')"
                />
            </sw-card>
            {% endblock %}

            {# One card, one sequence. The conversation and the timeline were
               two cards describing the same events, which cost twice: the
               agent's sentence appeared in both — once as its quote comment,
               once as the pass's `replyToBuyer` — and seeing which comment
               caused which pass meant lining timestamps up by eye across a
               card boundary. Merged, a buyer's ask is followed by the pass
               that answered it. See `mergeStream()`.

               Buyer comments are read off the quote and never out of the
               decision table: their own words are deliberately not recorded
               there, only the interpreted ask. So when the quote cannot be
               read — Commercial absent, or the role without
               `quote_comment:read` — those entries are simply missing and the
               passes still carry everything they recorded. #}
            {% block merchant_quote_agent_detail_history %}
            <sw-card
                v-if="record"
                :title="$tc('merchant-quote-agent.detail.historyTitle')"
                :subtitle="$tc('merchant-quote-agent.detail.historySubtitle')"
            >
                <ol class="mqa-timeline">
                    <li
                        v-for="entry in stream"
                        :key="entry.key"
                        class="mqa-entry"
                        :class="[`mqa-entry--${entry.kind}`, `mqa-entry--${entry.variant}`]"
                    >
                        {# What the customer actually said. The pass below shows
                           what the agent made of it, which is unreadable
                           without this: an ask recorded as "discount: 8.0%" was
                           a sentence first, and a merchant judging whether the
                           agent read it correctly needs the sentence. #}
                        <template v-if="entry.kind === 'message'">
                            <div class="mqa-entry__header">
                                <h4 class="mqa-entry__title">{{ $tc('merchant-quote-agent.detail.fromCustomer') }}</h4>
                                <span class="mqa-entry__time">{{ formatDate(entry.at) }}</span>
                            </div>
                            <p class="mqa-msg">{{ entry.message.text }}</p>
                        </template>

                        {# How it ended. The summary card above says the same
                           state, but the sequence used to trail off after the
                           last pass — so a quote that was ordered two days
                           later read as though nothing had happened since. #}
                        <template v-else-if="entry.kind === 'outcome'">
                            <div class="mqa-entry__header">
                                <h4 class="mqa-entry__title">{{ terminalTitle(entry.state) }}</h4>
                                <span class="mqa-entry__time">{{ formatDate(entry.at) }}</span>
                            </div>
                            <p v-if="terminalWhy(entry.state)" class="mqa-entry__why">{{ terminalWhy(entry.state) }}</p>
                        </template>

                        <template v-else>
                            <div class="mqa-entry__header">
                                <span class="mqa-run__index">#{{ entry.run.index }}</span>
                                <h4 class="mqa-entry__title">{{ $tc('merchant-quote-agent.detail.agentTitle') }}</h4>
                                <mt-badge :variant="entry.run.outcomeVariant">{{ entry.run.outcomeLabel }}</mt-badge>
                                <span class="mqa-entry__time">{{ entry.run.timestamp }}</span>
                            </div>

                            {# The headline caveat about this pass, above its
                               figures: a pass that reports an offer sent and
                               still needs a person has to say so before the
                               numbers, not inside a fold. #}
                            <ul v-if="entry.run.notes.length" class="mqa-notes">
                                <li
                                    v-for="note in entry.run.notes"
                                    :key="note.key"
                                    class="mqa-note"
                                    :class="`mqa-note--${note.variant}`"
                                >
                                    <span>{{ note.text }}</span>
                                    <span v-if="note.detail" class="mqa-run__quiet">{{ note.detail }}</span>
                                </li>
                            </ul>

                            <dl v-if="!entry.run.isNoop" class="mqa-run__facts">
                                {# What the buyer asked for, as the agent read
                                   it. Only ever recorded in structured form,
                                   so this is all of it. #}
                                <template v-if="entry.run.asks.length">
                                    <template v-for="ask in entry.run.asks" :key="ask.label">
                                        <dt class="mqa-run__fact-label">{{ ask.label }}</dt>
                                        <dd class="mqa-run__fact-value mqa-run__fact-value--numeric">{{ ask.value }}</dd>
                                    </template>
                                </template>

                                <template v-if="entry.run.band">
                                    <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.detail.bandLabel') }}</dt>
                                    <dd class="mqa-run__fact-value">
                                        <mt-badge :variant="entry.run.bandVariant">{{ entry.run.band }}</mt-badge>
                                        <span class="mqa-run__quiet">
                                            {{ $t('merchant-quote-agent.figures.ofCap', { cap: entry.run.cap }) }}
                                        </span>
                                    </dd>
                                </template>

                                <template v-if="entry.run.granted">
                                    <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.detail.granted') }}</dt>
                                    <dd class="mqa-run__fact-value mqa-run__fact-value--numeric">
                                        <span class="mqa-run__granted">{{ entry.run.granted }}</span>
                                        <span v-if="entry.run.totals" class="mqa-run__quiet">{{ entry.run.totals }}</span>
                                    </dd>
                                </template>

                                {# Whether the agent touched the quote at all,
                                   and how. Recorded since the table existed
                                   and only ever shown as raw method names
                                   inside the technical fold. #}
                                <template v-if="entry.run.changes.length">
                                    <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.detail.changesLabel') }}</dt>
                                    <dd class="mqa-run__fact-value">
                                        <ul class="mqa-changes">
                                            <li v-for="change in entry.run.changes" :key="change">{{ change }}</li>
                                        </ul>
                                    </dd>
                                </template>

                                {# The label alone said which bucket the pass
                                   fell into. What a merchant needs is why, with
                                   this pass's numbers in it, and then the
                                   specific rule underneath. All of it was
                                   already recorded. #}
                                <template v-if="entry.run.escalationReason">
                                    <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.detail.escalationReason') }}</dt>
                                    <dd class="mqa-run__fact-value">
                                        <mt-badge variant="critical">{{ entry.run.escalationReason }}</mt-badge>
                                        <span class="mqa-run__why">{{ entry.run.escalationWhy }}</span>
                                        <span v-if="entry.run.escalationDetail" class="mqa-run__quiet">
                                            {{ entry.run.escalationDetail }}
                                        </span>
                                    </dd>
                                </template>

                                {# The agent's own sentence, in the pass that
                                   composed it rather than in a second card. #}
                                <template v-if="entry.run.reply">
                                    <dt class="mqa-run__fact-label">{{ $tc('merchant-quote-agent.detail.replyLabel') }}</dt>
                                    <dd class="mqa-run__fact-value mqa-run__message">{{ entry.run.reply }}</dd>
                                </template>
                            </dl>

                            <details class="mqa-tech">
                                <summary>{{ $tc('merchant-quote-agent.detail.technicalDetails') }}</summary>
                                <div class="mqa-tech__grid">
                                    <div
                                        v-for="row in entry.run.technical"
                                        :key="row.label"
                                        :class="{ 'mqa-tech__row--wide': row.wide }"
                                    >
                                        <span class="mqa-tech__label">{{ row.label }}</span>
                                        <span
                                            class="mqa-tech__value"
                                            :class="{ 'mqa-tech__value--mono': row.mono }"
                                        >{{ row.value }}</span>
                                    </div>
                                </div>

                                {# Which strategy sent this pass, resolved from the
                                   recorded version id rather than the sales
                                   channel's current assignment -- so an edited or
                                   renamed strategy does not change what a past
                                   decision reports having sent. Null means the
                                   pass ran with no strategy configured, a valid
                                   state, and renders nothing at all. #}
                                <template v-if="entry.run.strategy">
                                    <div class="mqa-tech__grid">
                                        <div v-if="entry.run.strategy.unavailable">
                                            <span class="mqa-tech__label">{{ $tc('merchant-quote-agent.detail.strategyUsed') }}</span>
                                            <span class="mqa-tech__value">{{ $tc('merchant-quote-agent.detail.strategyUnavailable') }}</span>
                                        </div>
                                        <template v-else>
                                            <div>
                                                <span class="mqa-tech__label">{{ $tc('merchant-quote-agent.detail.strategyUsed') }}</span>
                                                <span class="mqa-tech__value">{{ entry.run.strategy.name }}</span>
                                            </div>
                                            <div>
                                                <span class="mqa-tech__label">{{ $tc('merchant-quote-agent.detail.strategyVersion') }}</span>
                                                <span class="mqa-tech__value">{{ entry.run.strategy.version }}</span>
                                            </div>
                                        </template>
                                    </div>

                                    <details v-if="!entry.run.strategy.unavailable" class="mqa-tech">
                                        <summary>{{ $tc('merchant-quote-agent.detail.strategyPrompt') }}</summary>
                                        <div class="mqa-tech__row--wide">
                                            <span class="mqa-tech__value">{{ entry.run.strategy.prompt }}</span>
                                        </div>
                                    </details>
                                </template>
                            </details>
                        </template>
                    </li>
                </ol>
            </sw-card>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
