// Committed config for MerchantQuoteAgentPlugin. Extends the generated Shopware bridge in .shopware/
// (git-ignored, holds the machine-specific paths). Safe to edit and commit — keep the "extends".
// Spec files stay excluded here — the check type-checks them separately with jest types.
{
    "extends": "./.shopware/tsconfig.json",
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "src/**/*.js"
    ],
    "exclude": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js"
    ]
}
